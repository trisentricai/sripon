# =============================================================================
# Environment Variables for E-Commerce Platform
# =============================================================================
# NEVER commit actual secrets. Copy .env.example to .env and fill in values.
# =============================================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# SERVER-ONLY: Never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=ksrw2cfi
CLOUDINARY_API_KEY=211299719778683
# SERVER-ONLY
CLOUDINARY_API_SECRET=5VwrKkeeOY5Gk2uMRcf5BDP9ujg

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# --- PhonePe (Sandbox for development) ---
PHONEPE_MERCHANT_ID=your-phonepe-merchant-id
PHONEPE_SALT_KEY=your-phonepe-salt-key
PHONEPE_SALT_INDEX=1
PHONEPE_ENVIRONMENT=SANDBOX
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# --- API ---
API_URL=http://localhost:3001
API_PORT=3001

# --- Frontend URLs ---
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# --- App ---
NODE_ENV=development
PORT=3001

# --- Email (optional, for notifications) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# --- Feature Flags ---
ENABLE_ANALYTICS=true
ENABLE_REDIS_CACHE=true
