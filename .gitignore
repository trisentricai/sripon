# ============================================================
# SriPon root .gitignore
# ============================================================

# ---- Environments / secrets (NEVER commit) ----
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*service-account*.json
google-services.json
GoogleService-Info.plist
firebase-adminsdk*.json

# ---- Python / Django ----
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.mypy_cache/
.dmypy.json
.pyre/
backend/db.sqlite3
backend/staticfiles/
backend/media/
backend/.pytest_cache/

# ---- Node / Vite ----
node_modules/
web/dist/
admin/dist/
web/node_modules/
admin/node_modules/
*.tsbuildinfo
web/*.tsbuildinfo
admin/*.tsbuildinfo
web/.vite/
admin/.vite/

# ---- Flutter / Dart (mobile/.gitignore covers most) ----
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/*/ios/Pods/
mobile/*/ios/.symlinks/

# ---- Editors / OS ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
*.log

# ---- Misc ----
.coverage
htmlcov/
.tox/
.nox/
.cache/