# ============================================================
# SriPon Customer Website - Environment Variables
# Copy to .env (Vite reads VITE_-prefixed variables).
# NEVER commit secrets to the repository.
# ============================================================

# Backend API base URL (Django, deployed on Render).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Firebase Web app configuration - create via Firebase Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Feature toggles
VITE_ENABLE_GOOGLE_SIGN_IN=true
VITE_ENABLE_PHONE_AUTH=false