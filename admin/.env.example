# ============================================================
# SriPon Admin Dashboard - Environment Variables
# Copy to .env (Vite reads VITE_-prefixed variables).
# NEVER commit secrets to the repository.
# ============================================================

# Backend API base URL (Django, deployed on Render).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase project (admin authentication + PostgreSQL host).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=