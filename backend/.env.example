# ============================================================
# SriPon Backend - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database (Supabase PostgreSQL) ---
# Format:
# postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Leave unset in local dev to use SQLite (zero-config local start).
DATABASE_URL=

# --- Redis (Render Redis or Redis Cloud) ---
# Format: redis://:PASSWORD@HOST:6379
# Leave unset in local dev to fall back to local-memory cache.
REDIS_URL=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# --- Firebase (customer authentication) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional: path to a service-account JSON for local dev
# FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Supabase (admin authentication + PostgreSQL host) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Cloudinary (product / banner / poster images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true
CLOUDINARY_FOLDER=sripon

# --- Payment gateway (provider-independent) ---
# Currently supported: MOCK, PHONEPE, RAZORPAY, STRIPE
PAYMENT_PROVIDER=MOCK
PAYMENT_MERCHANT_ID=
PAYMENT_SALT_KEY=
PAYMENT_SALT_INDEX=1
PAYMENT_CALLBACK_URL=https://api.sripon.in/api/v1/payments/webhook/phonepe/

# --- Store settings ---
CURRENCY=INR
STORE_NAME=SriPon
STORE_EMAIL=support@sripon.in
STORE_PHONE=

# --- Email (for transactional emails, optional) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Logging ---
LOG_LEVEL=INFO